  "main": "app/server.js",
  "name": "explo",
  "pnpm": {
    "minimumReleaseAgeExclude": [
      "@dolphjs/*"
    ]
  },
  "scripts": {
    "build": "dolph build",
    "build:tsc": "tsc && tsc-alias",
    "build:client": "pnpm --dir client build",
    "build:all": "pnpm build:tsc && pnpm --dir client build",
    "clean": "rm -r app && rm -r logs",
    "dev:docker:start": "docker-compose -f docker-compose-dev.yml up",
    "dev:docker:stop": "docker-compose -f docker-compose-dev.yml down",
    "dev:start": "dolph watch",
    "dev:client": "pnpm --dir client dev",
    "start": "dolph start",
    "test": "jest"
